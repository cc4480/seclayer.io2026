# --- Core ---
# NODE_ENV: set to "production" for deployment (enables Secure cookies, HSTS,
# trust proxy, and serving the prebuilt dist/ instead of the Vite dev server).
NODE_ENV="development"
# PORT: port the server listens on (deployment platforms usually inject this).
PORT="3000"
# APP_URL: public base URL of the app. Used to build magic-link sign-in URLs.
# Required in production so links point at the right host.
APP_URL="MY_APP_URL"
# DB_PATH: optional path to the SQLite database file (defaults to ./data.sqlite).
# DB_PATH="/data/seclayer.sqlite"
# APP_VERSION: optional build identifier (git SHA or release tag) surfaced by the
# /api/system/health endpoint so operators can confirm which build is live.
# APP_VERSION="dev"
# SECURITY_CONTACT / SECURITY_POLICY_URL: published in /.well-known/security.txt
# (RFC 9116). Contact defaults to security@<APP_URL host> when unset.
# SECURITY_CONTACT="mailto:security@yourdomain.com"
# SECURITY_POLICY_URL="https://yourdomain.com/security-policy"
# Automated SQLite snapshots (VACUUM INTO). On by default (except in-memory DBs).
# BACKUP_ENABLED="false"            # disable automated snapshots entirely
# BACKUP_DIR="/data/backups"        # default: a backups/ dir next to DB_PATH
# BACKUP_INTERVAL_HOURS="24"        # snapshot cadence in hours
# BACKUP_RETENTION="7"              # how many snapshots to keep
# DEV_SKIP_AUTH: on by default outside production — auto-authenticates every
# request as a fixed local "dev@localhost" account so you can use the app
# immediately without the magic-link sign-in flow while building. Never active
# when NODE_ENV=production. Set to "false" to exercise the real login flow locally.
# DEV_SKIP_AUTH="false"

# ENABLE_BROWSER_RENDERING: set to "true" to crawl SPA/JS-heavy targets with a
# headless browser (surfaces client-rendered links + XHR/fetch endpoints). Off
# by default to keep the deployment lean. When enabled, also install Playwright:
#   npm i playwright && npx playwright install --with-deps chromium
# ENABLE_BROWSER_RENDERING="false"

# ENABLE_TARGET_SCREENSHOT: set to "true" to capture a headless-browser
# screenshot of each scanned target's landing page, shown as "Visual Recon" in
# the report. Off by default (needs a browser + adds a few seconds per scan).
# Requires Playwright, same as above:
#   npm i playwright && npx playwright install --with-deps chromium
# ENABLE_TARGET_SCREENSHOT="false"

# SCAN_DEV_ALLOW_HOSTS: DEV-ONLY, opt-in escape hatch that lets the SSRF guard
# scan an explicit loopback target on this machine (e.g. an intentionally-
# vulnerable app under test-targets/) so the active red-team probes can be
# exercised against infrastructure you own. Comma-separated exact host[:port]
# entries. HARD-disabled when NODE_ENV=production. Leave unset in normal use.
# SCAN_DEV_ALLOW_HOSTS="127.0.0.1:4100"

# --- Unlocking active (red-team) probes on your own targets ---
# By default, active exploit probes (SQLi/XSS/cmd-injection/SSRF/etc.) only run
# once the caller has proven they own the target's domain (DNS TXT or a
# /.well-known file) — this stops the platform being used to attack sites the
# user doesn't own. To test YOUR OWN apps without that step, use one of:
#
# DEV_SKIP_DOMAIN_VERIFICATION: unlock active probes with no ownership proof.
# Simple, but DEV-ONLY — ignored when NODE_ENV=production.
# DEV_SKIP_DOMAIN_VERIFICATION="true"
#
# ALLOW_UNVERIFIED_ACTIVE_PROBES: same unlock, but honored in ALL environments
# (including production), on every scan path. Off by default. ONLY set this on a
# PRIVATE, single-user instance you control, testing targets you own — while it
# is on, anyone who can use this instance can aim active exploits at any domain.
# ALLOW_UNVERIFIED_ACTIVE_PROBES="true"

# --- AI reports (DeepSeek) ---
# DEEPSEEK_API_KEY: enables AI-generated reports. When unset, the app falls back
# to high-quality local summaries.
DEEPSEEK_API_KEY="MY_DEEPSEEK_API_KEY"
# Optional overrides for the DeepSeek API endpoint and model routing.
# DEEPSEEK_BASE_URL="https://api.deepseek.com"
# DEEPSEEK_MODEL_PRO="deepseek-v4-pro"      # deep security report reasoning
# DEEPSEEK_MODEL_FLASH="deepseek-v4-flash"  # fast PentAGI log narration

# --- Email (magic-link sign-in) ---
# RESEND_API_KEY: enables sending magic-link emails via Resend. When unset, the
# sign-in link is logged to the server console (dev/demo mode).
# RESEND_API_KEY="re_..."
# EMAIL_FROM: sender identity for outbound email.
# EMAIL_FROM="Seclayer <onboarding@resend.dev>"

# --- Free public testing ---
# FREE_MODE: when on, scans require no credits and the paywall is hidden — for
# free public testing. Defaults ON whenever Stripe is not configured (below), and
# OFF once it is, so the app is free out of the box and switches to paid when you
# wire up payments. Set explicitly to override the default.
# FREE_MODE="true"

# --- Payments (Stripe) ---
# STRIPE_SECRET_KEY + STRIPE_WEBHOOK_SECRET enable real credit purchases via
# Stripe Checkout. When unset, the buy-credits flow is disabled (no mock) and
# FREE_MODE defaults on. Point your Stripe webhook at POST /api/webhooks/stripe
# (event: checkout.session.completed) and paste the signing secret below.
# STRIPE_SECRET_KEY="sk_live_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
