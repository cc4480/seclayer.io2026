# --- Core ---
# NODE_ENV: set to "production" for deployment (enables Secure cookies, HSTS,
# trust proxy, and serving the prebuilt dist/ instead of the Vite dev server).
NODE_ENV="development"
# PORT: port the server listens on (deployment platforms usually inject this).
PORT="3000"
# APP_URL: public base URL of the app. Used to build magic-link sign-in URLs.
# Required in production so links point at the right host.
APP_URL="MY_APP_URL"
# DB_PATH: optional path to the SQLite database file (defaults to ./data.sqlite).
# DB_PATH="/data/seclayer.sqlite"
# DEV_SKIP_AUTH: on by default outside production — auto-authenticates every
# request as a fixed local "dev@localhost" account so you can use the app
# immediately without the magic-link sign-in flow while building. Never active
# when NODE_ENV=production. Set to "false" to exercise the real login flow locally.
# DEV_SKIP_AUTH="false"

# ENABLE_BROWSER_RENDERING: set to "true" to crawl SPA/JS-heavy targets with a
# headless browser (surfaces client-rendered links + XHR/fetch endpoints). Off
# by default to keep the deployment lean. When enabled, also install Playwright:
#   npm i playwright && npx playwright install --with-deps chromium
# ENABLE_BROWSER_RENDERING="false"

# --- AI reports (DeepSeek) ---
# DEEPSEEK_API_KEY: enables AI-generated reports. When unset, the app falls back
# to high-quality local summaries.
DEEPSEEK_API_KEY="MY_DEEPSEEK_API_KEY"
# Optional overrides for the DeepSeek API endpoint and model routing.
# DEEPSEEK_BASE_URL="https://api.deepseek.com"
# DEEPSEEK_MODEL_PRO="deepseek-v4-pro"      # deep security report reasoning
# DEEPSEEK_MODEL_FLASH="deepseek-v4-flash"  # fast PentAGI log narration

# --- Email (magic-link sign-in) ---
# RESEND_API_KEY: enables sending magic-link emails via Resend. When unset, the
# sign-in link is logged to the server console (dev/demo mode).
# RESEND_API_KEY="re_..."
# EMAIL_FROM: sender identity for outbound email.
# EMAIL_FROM="Seclayer <onboarding@resend.dev>"

# --- Payments (Stripe) ---
# STRIPE_SECRET_KEY + STRIPE_WEBHOOK_SECRET enable real credit purchases via
# Stripe Checkout. When unset, the buy-credits flow is disabled (no mock).
# Point your Stripe webhook at POST /api/webhooks/stripe (event:
# checkout.session.completed) and paste the signing secret below.
# STRIPE_SECRET_KEY="sk_live_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
