{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    // Enabled 2026-09-09. It cost 28 errors across ~36k lines and caught two
    // real defects (a "NaN" score delta, a possibly-undefined DATABASE_URL),
    // which is a good trade for the class of bug it prevents from here on.
    // noImplicitAny is deliberately NOT enabled: it reports 2743 errors and is
    // a different size of job.
    "strictNullChecks": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "exclude": [
    "mcp-server",
    "dist",
    "node_modules",
    "test-targets/tier3-baas-supabase/supabase/functions"
  ]
}
